# Copy to .env (never commit .env). Every value is optional; defaults work offline.
RESQTEXT_LABEL_THRESHOLD=0.40
RESQTEXT_SIMILARITY_THRESHOLD=0.70
RESQTEXT_DIFF_LOCATION_PENALTY=0.25
RESQTEXT_TIME_WINDOW_HOURS=72
# Semantic duplicate detection with Sentence Transformers (needs: pip install sentence-transformers)
RESQTEXT_USE_SENTENCE_TRANSFORMERS=0
# Online geocoding via OpenStreetMap Nominatim (OFF by default; set a real contact in the user agent)
RESQTEXT_ENABLE_GEOCODING=0
RESQTEXT_GEOCODER_UA=ResQText-demo (you@example.com)
# Optional transformer classifier (needs: pip install transformers torch)
RESQTEXT_USE_TRANSFORMER=0

# ======================= Real-world data (v2) =======================
# Run mode. "local" = single-user demo (no login). Use "production" for anything other people can reach.
RESQTEXT_ENV=local
# Protects review / refresh / delete in the dashboard. REQUIRED in production, otherwise those actions stay disabled.
RESQTEXT_ADMIN_PASSCODE=
# Protects write endpoints of the API (send as the X-API-Key header). REQUIRED in production.
RESQTEXT_API_KEY=

# ReliefWeb needs an APPROVED appname: https://apidoc.reliefweb.int/parameters#appname   (not set = source is skipped)
RELIEFWEB_APPNAME=
RELIEFWEB_COUNTRY=India
# GDACS and NDMA Sachet need no key.
GDACS_ENABLED=1
SACHET_ENABLED=1
# Polling intervals in minutes (minimums are enforced: GDACS 15, Sachet 5, ReliefWeb 30)
GDACS_INTERVAL_MIN=30
SACHET_INTERVAL_MIN=10
RELIEFWEB_INTERVAL_MIN=60
# Automatic polling. Recommended: run `python -m ingestion.scheduler` as a separate process and leave these at 0.
RESQTEXT_AUTOPOLL=0
RESQTEXT_AUTOPOLL_IN_DASHBOARD=0
# Set to 1 ONLY after you have validated the classifier on labelled real reports.
RESQTEXT_NLP_VALIDATED_ON_REAL=0
